includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	phpVersion: 80300
	paths:
		- relevant-forms.php
		- src
	excludePaths:
		analyseAndScan:
			- vendor
			- tests
			- templates
		analyse:
			# Extends the Divi Builder class (ET_Builder_Module), which only exists
			# on sites running Divi; loaded at runtime by DiviIntegration::loadModule().
			- src/Integrations/Divi/FormModule.php
	bootstrapFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- tests/phpstan-constants.php
	treatPhpDocTypesAsCertain: false
