{
    "name": "relevant-forms/relevant-forms",
    "description": "WordPress forms that understand which messages matter. Semantic spam filtering, priority alerts and secure private uploads.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "plugin",
        "forms",
        "spam",
        "ai"
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "pestphp/pest": "^3.7",
        "php-stubs/wordpress-stubs": "^6.9",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "RelevantForms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RelevantForms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml.dist",
        "lint:fix": "phpcbf --standard=phpcs.xml.dist",
        "lint:compat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 8.3-8.5 src relevant-forms.php templates",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "pest",
        "test:unit": "pest --group=unit",
        "test:integration:start": "npx --yes @wordpress/env start --config=.wp-env.test.json",
        "test:integration:stop": "npx --yes @wordpress/env stop --config=.wp-env.test.json",
        "test:integration": "npx --yes @wordpress/env run --config=.wp-env.test.json tests-wordpress bash -c 'cd /var/www/html/wp-content/plugins/relevant-forms/tests/Integration && composer install --no-interaction --no-progress && php vendor/bin/phpunit --configuration /var/www/html/wp-content/plugins/relevant-forms/phpunit.integration.xml.dist'",
        "build:release": "bash bin/build-release.sh",
        "i18n": "wp i18n make-pot . languages/relevant-forms.pot --slug=relevant-forms --domain=relevant-forms --exclude=vendor,tests"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "process-timeout": 900,
        "allow-plugins": {
            "automattic/jetpack-autoloader": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
