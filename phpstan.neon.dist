includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	phpVersion: 80300
	paths:
		- relevant-forms.php
		- src
	excludePaths:
		analyseAndScan:
			- vendor
			- tests
			- templates
		analyse:
			# Extend builder classes that only exist on sites running the builder
				# (loaded at runtime by their integrations).
			- src/Integrations/BeaverBuilder/FormModule.php
			- src/Integrations/Bricks/FormElement.php
			- src/Integrations/Divi/FormModule.php
			- src/Integrations/Elementor/FormWidget.php
	bootstrapFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- tests/phpstan-constants.php
	treatPhpDocTypesAsCertain: false
