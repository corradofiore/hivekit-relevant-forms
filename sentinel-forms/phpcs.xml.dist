<?xml version="1.0"?>
<ruleset name="SentinelForms">
	<description>Sentinel Forms WordPress coding standards.</description>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.9"/>
	<config name="testVersion" value="8.3-"/>

	<file>sentinel-forms.php</file>
	<file>src</file>
	<file>tests</file>
	<file>templates</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.PHP.YodaConditions"/>
	</rule>

	<!--
		Docblocks are required for public APIs, but the full PHPDocumentor
		param/capitalization style is not enforced on every method.
	-->
	<rule ref="Squiz.Commenting.FunctionComment">
		<severity>0</severity>
	</rule>
	<rule ref="Generic.Commenting.DocComment.ShortNotCapital">
		<severity>0</severity>
	</rule>

	<!-- Pest requires its configuration file to be named Pest.php. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>*/tests/Pest.php</exclude-pattern>
	</rule>

	<!--
		PSR-4 autoloading requires class files to match class names, so
		CamelCase filenames are expected under src/ and tests/.
	-->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>*/src/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!--
		This plugin stores its data in custom tables, so the direct
		database query sniff (which targets core-table caching) is disabled.
		Prepared statements are still required and enforced.
	-->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<severity>0</severity>
	</rule>

	<!-- Custom tables use meta_key/meta_value column names; the core-table
		slow-query heuristic does not apply. -->
	<rule ref="WordPress.DB.SlowDBQuery">
		<severity>0</severity>
	</rule>

	<!-- Table names are interpolated from internal constants, never user
		input; value placeholders remain prepared. -->
	<rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders.ReplacementsWrongNumber">
		<severity>0</severity>
	</rule>

	<!-- Every value in every query uses $wpdb->prepare(); the parser cannot
		verify queries whose table names are interpolated variables. -->
	<rule ref="WordPress.DB.PreparedSQL.NotPrepared">
		<severity>0</severity>
	</rule>

	<!--
		The codebase targets PHP 8.4+ and intentionally uses short array
		syntax and camelCase property names (readonly promotion). These two
		style-only sniffs are disabled; all escaping, SQL, hook and docs
		rules from the WordPress standard remain enforced.
	-->
	<rule ref="Universal.Arrays.DisallowShortArraySyntax">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName.InterpolatedVariableNotSnakeCase">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidFunctionName">
		<severity>0</severity>
	</rule>

	<!-- Templates contain no executable logic; relax escaping review there. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>*/templates/*</exclude-pattern>
	</rule>
</ruleset>
