{
    "name": "sentinel-forms/integration-tests",
    "description": "Isolated Composer project for WordPress integration tests (runs inside wp-env's tests-wordpress container).",
    "type": "project",
    "require": {
        "php": "^8.4",
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^6.9",
        "yoast/phpunit-polyfills": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "SentinelForms\\Tests\\Integration\\": "./"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    }
}
